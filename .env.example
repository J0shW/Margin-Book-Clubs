NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Without it, book search calls the Google Books API
# unauthenticated, which shares a small public quota and can 429 under
# normal traffic. Get a key at https://console.cloud.google.com/
# (enable the "Books API", then create an API key) and restrict it to
# that API.
GOOGLE_BOOKS_API_KEY=
